{
  "waitTool": false,
  "toolDescriptionMode": "compact",
  "defaultSessionDir": "~/.pi/subagent-sessions",
  "toolExtensions": {
    "mcp": {
      "description": "On-demand generic MCP access for delegated work. When an eligible child needs a configured server, add this bundle with requiresCapabilities: [\"mcp\"] instead of keeping the work in the parent or creating a one-off agent.",
      "builtinTools": ["mcp"],
      "allowedAgents": ["clone", "context-builder", "oracle", "planner", "researcher", "reviewer", "run-monitor", "scout"]
    }
  },
  "forceTopLevelAsync": true,
  "maxSubagentDepth": 2,
  "maxSubagentSpawnsPerRun": 20000,
  "maxSubagentSpawnsPerSession": 20000,
  "globalConcurrencyLimit": 100,
  "scheduledRuns": {
    "enabled": false
  },
  "missions": {
    "enabled": false
  },
  "control": {
    "needsAttentionAfterMs": 60000,
    "activeNoticeAfterMs": 120000,
    "notifyChannels": ["event", "async"]
  },
  "intercomBridge": {
    "resultDelivery": false
  }
}
