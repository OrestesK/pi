{
  "defaultProvider": "openai-codex",
  "defaultModel": "gpt-5.6-sol",
  "defaultThinkingLevel": "high",
  "theme": "gruvbox-custom",
  "quietStartup": true,
  "defaultProjectTrust": "always",
  "steeringMode": "all",
  "followUpMode": "all",
  "collapseChangelog": true,
  "enableInstallTelemetry": false,
  "npmCommand": [
    "sh",
    "-lc",
    "npm --prefix \"$HOME/.npm-global\" \"$@\"",
    "npm"
  ],
  "branchSummary": {
    "skipPrompt": true
  },
  "hideThinkingBlock": true,
  "terminal": {
    "showImages": true,
    "imageWidthCells": 80,
    "showTerminalProgress": true
  },
  "editorPaddingX": 0,
  "outputPad": 0,
  "retry": {
    "maxRetries": 3,
    "baseDelayMs": 2000
  },
  "lastChangelogVersion": "0.80.6",
  "transport": "auto",
  "compaction": {
    "enabled": true,
    "reserveTokens": 24000,
    "keepRecentTokens": 20000
  },
  "slipstreamCompact": {
    "enabled": true,
    "autoTrigger": true,
    "triggerContextPercent": 0.6,
    "slipstreamKeepRecentTokens": 50000,
    "summaryModel": "openai-codex/gpt-5.6-terra",
    "judgeModel": "openai-codex/gpt-5.6-sol",
    "judgeThreshold": 7,
    "repairAttempts": 3,
    "rejectedSummaryMode": "ask",
    "pendingTtlMs": 300000,
    "artifactRoot": ".scratch/compactions"
  },
  "skills": [
    "skills"
  ],
  "packages": [
    "extensions/claude-ui",
    {
      "source": "git:github.com/nicobailon/pi-intercom@e234a4446e2b3f9c13a1ec3151ae2169315c810f",
      "skills": []
    },
    {
      "source": "git:github.com/OrestesK/agent-toolkit-for-aws@11d76e13231ac28b5e71980481485639268a964e",
      "extensions": [],
      "skills": [
        "skills/core-skills/aws-cdk",
        "skills/core-skills/aws-cloudformation",
        "skills/core-skills/aws-compute",
        "skills/core-skills/aws-containers",
        "skills/core-skills/aws-database",
        "skills/core-skills/aws-deployment",
        "skills/core-skills/aws-iam",
        "skills/core-skills/aws-messaging-and-streaming",
        "skills/core-skills/aws-observability",
        "skills/core-skills/aws-serverless",
        "skills/core-skills/signing-in-to-aws",
        "skills/specialized-skills/operations-skills/troubleshooting-application-failures"
      ],
      "prompts": [],
      "themes": []
    },
    {
      "source": "packages/pi-subagents",
      "skills": [],
      "prompts": []
    },
    "packages/pi-fff",
    "npm:pi-mcp-adapter",
    {
      "source": "packages/pi-lens",
      "autoload": false,
      "extensions": [
        "+dist/index.js"
      ]
    },
    "npm:pi-web-access",
    "npm:@aliou/pi-guardrails",
    {
      "source": "npm:pi-ask-user",
      "skills": []
    },
    "packages/pi-tool-result-virtualizer",
    {
      "source": "packages/context-mode",
      "skills": [
        "ctx-doctor"
      ]
    },
    "packages/pi-slipstream-compact",
    "packages/pi-goal-supervisor",
    "packages/pisesh",
    "npm:pi-btw",
    "packages/pi-sixel",
    "npm:@carter-mcalister/pi-codex-image-gen@0.2.0"
  ],
  "pi-sixel": {
    "maxColumns": 120,
    "maxRows": 36,
    "quality": "high"
  },
  "subagents": {
    "defaultModel": "openai-codex/gpt-5.6-terra",
    "disableBuiltins": false,
    "agentOverrides": {
      "delegate": {
        "disabled": true
      },
      "worker": {
        "disabled": true
      }
    }
  },
  "autocompleteMaxVisible": 10,
  "doubleEscapeAction": "tree",
  "treeFilterMode": "no-tools",
  "httpIdleTimeoutMs": 3600000,
  "enabledModels": [
    "openai-codex/gpt-5.3-codex-spark",
    "openai-codex/gpt-5.4",
    "openai-codex/gpt-5.4-mini",
    "openai-codex/gpt-5.5",
    "openai-codex/gpt-5.6-luna",
    "openai-codex/gpt-5.6-sol",
    "openai-codex/gpt-5.6-terra"
  ]
}